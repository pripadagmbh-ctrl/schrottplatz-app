{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["materials", "shapes"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "materials": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "tier", "densityKgM3", "buyPricePerKg", "sellPricePerKg", "color", "icon", "containerId"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+$" },
          "tier": { "enum": ["MVP", "V1", "LATER"] },
          "densityKgM3": { "type": "number", "minimum": 100, "maximum": 20000 },
          "buyPricePerKg": { "type": "number", "minimum": 0 },
          "sellPricePerKg": { "type": "number" },
          "pricePerPiece": { "type": "boolean" },
          "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
          "secondaryColor": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
          "icon": { "type": "string" },
          "containerId": { "type": ["string", "null"] },
          "sortsAs": { "type": "string" },
          "hazard": { "type": "boolean" },
          "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
          "roughness": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "shapes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "collider", "sizeMin", "sizeMax", "fill", "materialIds", "tris"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "collider": { "enum": ["box", "cylinder", "sphere", "convex"] },
          "sizeMin": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 3, "maxItems": 3 },
          "sizeMax": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 3, "maxItems": 3 },
          "fill": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "materialIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "tris": { "type": "integer", "minimum": 8, "maximum": 1000 },
          "weight": { "type": "number", "minimum": 0 },
          "_note": { "type": "string" }
        }
      }
    }
  }
}
