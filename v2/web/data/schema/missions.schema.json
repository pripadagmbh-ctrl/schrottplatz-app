{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["missions", "perDay", "starsPerMission"],
  "properties": {
    "perDay": { "enum": [3] },
    "starsPerMission": { "enum": [1] },
    "missions": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "type", "tier", "params", "bonusEur", "fromDay", "weight"],
        "properties": {
          "type": { "enum": ["deliver", "clear", "customer", "dismantle", "press", "clean"] },
          "tier": { "enum": ["MVP", "V1", "LATER"] },
          "bonusEur": { "type": "number", "minimum": 0 },
          "fromDay": { "type": "integer", "minimum": 0 },
          "toDay": { "type": "integer", "minimum": 0 },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
