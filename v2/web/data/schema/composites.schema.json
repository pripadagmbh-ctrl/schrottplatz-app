{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["composites"],
  "definitions": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
  },
  "properties": {
    "$schema": { "type": "string" }, "_comment": { "type": "string" },
    "composites": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tier", "buyPriceEur", "hull", "crushScales", "glassImpactDv", "crushImpactDv", "parts"],
        "properties": {
          "id": { "type": "string" },
          "tier": { "enum": ["MVP", "V1", "LATER"] },
          "buyPriceEur": { "type": "number", "minimum": 0 },
          "hull": {
            "type": "object", "required": ["materialId", "massKg", "collider", "half", "yOffset"],
            "properties": {
              "materialId": { "type": "string" }, "massKg": { "type": "number", "exclusiveMinimum": 0 },
              "collider": { "enum": ["box"] }, "half": { "$ref": "#/definitions/vec3" }, "yOffset": { "type": "number" }
            }
          },
          "crushScales": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "minItems": 3, "maxItems": 3 },
          "glassImpactDv": { "type": "number", "exclusiveMinimum": 0 },
          "crushImpactDv": { "type": "number", "exclusiveMinimum": 0 },
          "parts": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "materialId", "massKg", "anchor", "grabRadius", "tearSeconds", "tool", "requires", "blocksPress", "unlockDay", "shape", "color"],
              "properties": {
                "id": { "type": "string" }, "materialId": { "type": "string" },
                "massKg": { "type": "number", "exclusiveMinimum": 0 },
                "anchor": { "$ref": "#/definitions/vec3" },
                "grabRadius": { "type": "number", "exclusiveMinimum": 0 },
                "tearSeconds": { "type": "number", "exclusiveMinimum": 0 },
                "tool": { "enum": ["grapple", "shear"] },
                "requires": { "type": "array", "items": { "type": "string" } },
                "blocksPress": { "type": "boolean" },
                "unlockDay": { "type": "integer", "minimum": 0 },
                "tier": { "enum": ["MVP", "V1", "LATER"] },
                "shape": { "type": "object", "required": ["kind", "size"], "properties": { "kind": { "enum": ["box", "wheel", "cylinder"] }, "size": { "type": "array", "items": { "type": "number" } } } },
                "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
              }
            }
          },
          "windows": { "type": "array", "items": { "type": "object", "required": ["id", "anchor", "size", "rotY"] } }
        }
      }
    }
  }
}
