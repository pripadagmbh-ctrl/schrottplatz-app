{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["vehicles", "customers", "privateNames"],
  "properties": {
    "vehicles": { "type": "array", "minItems": 4, "items": { "type": "object", "required": ["id", "routeIn", "routeOut", "speedMs", "dumpSeconds", "loadKgMin", "loadKgMax", "itemsMin", "itemsMax", "tier"] } },
    "customers": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "displayName", "kind", "hardness", "vehicleIds", "loadProfile", "sortedProbability", "patienceSeconds", "fromDay", "weight"],
        "properties": {
          "kind": { "enum": ["private", "trade", "dealer"] },
          "hardness": { "type": "integer", "minimum": 1, "maximum": 5 },
          "vehicleIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "loadProfile": { "type": "array", "items": { "type": "object", "required": ["materialId", "share"], "properties": { "share": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } } },
          "compositeDefId": { "type": "string" },
          "sortedProbability": { "type": "number", "minimum": 0, "maximum": 1 },
          "patienceSeconds": { "type": "number", "minimum": 10 },
          "fromDay": { "type": "integer", "minimum": 0 },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "privateNames": { "type": "array", "minItems": 10, "items": { "type": "string" } }
  }
}
